import "file"

var UI_PATH = "wyrm_ui.html";

func _css() {
    var s = [];
    s.push(":root{");
    s.push("  --bg:#09090b;--bg-2:#18181b;--bg-3:#27272a;--border:#3f3f46;");
    s.push("  --fg:#fafafa;--fg-dim:#a1a1aa;--fg-faint:#71717a;");
    s.push("  --accent:#ffffff;--accent-2:#e4e4e7;");
    s.push("  --user:#ffffff;--bot:transparent;--tool:#18181b;--err:#ef4444;--ok:#10b981;");
    s.push("  --shadow:0 12px 40px rgba(0,0,0,.4);");
    s.push("  --radius:16px;--radius-sm:8px;--ease:cubic-bezier(.16,1,.3,1);");
    s.push("}");
    s.push("[data-theme=light]{");
    s.push("  --bg:#ffffff;--bg-2:#f4f4f5;--bg-3:#e4e4e7;--border:#d4d4d8;");
    s.push("  --fg:#09090b;--fg-dim:#52525b;--fg-faint:#a1a1aa;");
    s.push("  --user:#09090b;--bot:transparent;--tool:#fafafa;--shadow:0 12px 32px rgba(0,0,0,.08);");
    s.push("}");
    s.push("*{box-sizing:border-box;margin:0;padding:0}");
    s.push("html,body{height:100%;font-family:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;");
    s.push("  background:var(--bg);color:var(--fg);overflow:hidden;font-size:15px;line-height:1.6}");
    
    s.push(".login-bg { position:fixed; inset:0; background:var(--bg); z-index:100; display:flex; align-items:center; justify-content:center; animation:fade-in .3s var(--ease); }");
    s.push(".login-card { background:var(--bg-2); border:1px solid var(--border); padding:40px; border-radius:var(--radius); width:100%; max-width:380px; text-align:center; box-shadow:var(--shadow); }");
    s.push(".login-card h2 { font-size:24px; font-weight:600; margin-bottom:8px; color:var(--fg); letter-spacing:-0.02em; }");
    s.push(".login-card p { color:var(--fg-dim); font-size:14px; margin-bottom:28px; }");
    s.push(".login-input { width:100%; background:var(--bg); border:1px solid var(--border); padding:14px 16px; border-radius:8px; margin-bottom:16px; color:var(--fg); font-size:14.5px; outline:none; transition:border-color .2s var(--ease); }");
    s.push(".login-input:focus { border-color:var(--fg-dim); }");
    s.push(".login-btn { width:100%; background:var(--fg); color:var(--bg); border:none; padding:14px; border-radius:8px; font-size:15px; font-weight:600; cursor:pointer; transition:transform .2s var(--ease), opacity .2s; }");
    s.push(".login-btn:hover { transform:translateY(-1px); opacity:0.9; }");
    s.push(".login-err { color:var(--err); font-size:13px; margin-bottom:16px; display:none; background:rgba(239,68,68,0.1); padding:10px; border-radius:6px; }");
    s.push(".login-logo { width:140px; height:auto; display:block; margin:0 auto 18px; }");
    s.push(".login-card .login-sub { color:var(--fg-dim); font-size:13px; margin-bottom:28px; }");
    s.push(".login-foot { margin-top:24px; color:var(--fg-faint); font-size:12px; letter-spacing:.01em; }");
    s.push(".login-foot b { color:var(--fg-dim); font-weight:600; }");

    s.push(".app{display:grid;grid-template-columns:260px 1fr;height:100vh;transition:grid-template-columns .25s var(--ease)}");
    s.push(".app.sidebar-collapsed{grid-template-columns:0 1fr}");
    s.push(".app.sidebar-collapsed .sidebar{transform:translateX(-100%);}");
    s.push(".sidebar-backdrop{display:none}");

    s.push(".sidebar{background:var(--bg-2);border-right:1px solid var(--border);display:flex;flex-direction:column;");
    s.push("  transition:transform .25s var(--ease);overflow:hidden}");
    s.push(".sidebar-header{padding:20px 16px 16px;display:flex;align-items:center;gap:12px}");
    s.push(".logo{width:34px;height:34px;border-radius:10px;background:var(--bg-3);border:1px solid var(--border);display:grid;place-items:center;}");
    s.push(".logo svg{width:24px;height:auto;display:block}");
    s.push(".brand{font-weight:600;font-size:16px;letter-spacing:-.01em}");
    s.push(".brand-sub{font-size:11px;color:var(--fg-faint);letter-spacing:.05em;text-transform:uppercase;margin-top:2px}");
    s.push(".new-chat{margin:8px 16px;padding:12px 14px;border:1px solid var(--border);background:var(--bg);color:var(--fg);");
    s.push("  border-radius:var(--radius-sm);cursor:pointer;display:flex;align-items:center;gap:10px;font-weight:500;font-size:14px;");
    s.push("  transition:all .15s var(--ease)}");
    s.push(".new-chat:hover{border-color:var(--fg-dim);}");
    s.push(".sessions{flex:1;overflow-y:auto;padding:10px 12px}");
    s.push(".session-item{padding:10px 12px;border-radius:8px;cursor:pointer;display:flex;align-items:center;gap:10px;");
    s.push("  font-size:13.5px;color:var(--fg-dim);transition:all .15s var(--ease);position:relative}");
    s.push(".session-item:hover{background:var(--bg-3);color:var(--fg)}");
    s.push(".session-item.active{background:var(--bg-3);color:var(--fg);font-weight:500}");
    s.push(".session-title{flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}");
    s.push(".session-del{opacity:0;font-size:16px;cursor:pointer;padding:0 6px;border-radius:4px;color:var(--fg-faint)}");
    s.push(".session-item:hover .session-del{opacity:1}");
    s.push(".session-del:hover{color:var(--err)}");
    s.push(".sidebar-footer{padding:12px 16px 16px;display:flex;flex-direction:column;gap:10px;font-size:12px;color:var(--fg-dim)}");
    s.push(".sidebar-status-row{display:flex;gap:12px;align-items:center;min-width:0}");
    s.push(".sidebar-status-row > span:nth-child(2){flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}");
    s.push(".status-dot{width:8px;height:8px;border-radius:50%;background:var(--ok);box-shadow:0 0 10px var(--ok);flex-shrink:0}");
    s.push(".status-dot.err{background:var(--err);box-shadow:0 0 10px var(--err)}");
    s.push(".icon-btn{background:transparent;border:1px solid var(--border);color:var(--fg-dim);width:36px;height:36px;");
    s.push("  border-radius:8px;cursor:pointer;display:grid;place-items:center;transition:all .15s var(--ease);flex-shrink:0}");
    s.push(".icon-btn:hover{border-color:var(--fg-dim);color:var(--fg);background:var(--bg-3)}");
    s.push(".logout-btn{width:100%;padding:10px 12px;border:1px solid var(--border);background:transparent;color:var(--fg-dim);");
    s.push("  border-radius:8px;cursor:pointer;font-size:13px;display:flex;align-items:center;justify-content:center;gap:8px;");
    s.push("  transition:all .15s var(--ease);font-family:inherit;font-weight:500}");
    s.push(".logout-btn:hover{color:var(--err);border-color:var(--err);background:rgba(239,68,68,0.06)}");
    s.push(".logout-btn .icn{flex-shrink:0;display:block}");

    s.push(".main{display:flex;flex-direction:column;overflow:hidden;background:var(--bg)}");
    s.push(".topbar{padding:16px 24px;display:flex;align-items:center;gap:16px;background:transparent}");
    s.push(".topbar-title{font-weight:500;flex:1;font-size:15px;color:var(--fg-dim);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}");
    s.push(".provider-pill{font-size:12px;padding:6px 12px;border-radius:20px;background:var(--bg-2);border:1px solid var(--border);color:var(--fg-dim);display:flex;align-items:center;gap:8px}");
    s.push(".provider-pill b{color:var(--fg);font-weight:500}");

    s.push(".chat{flex:1;overflow-y:auto;padding:20px 8px 40px;scroll-behavior:smooth}");
    s.push(".chat-inner{max-width:800px;margin:0 auto;padding:0 24px;display:flex;flex-direction:column;gap:32px}");
    s.push(".empty-state{text-align:center;color:var(--fg-faint);padding:10vh 20px;animation:fade-in .4s var(--ease)}");
    s.push(".empty-state h2{font-size:32px;font-weight:600;margin-bottom:12px;color:var(--fg);letter-spacing:-0.02em}");
    s.push(".empty-state p{color:var(--fg-dim);max-width:500px;margin:0 auto 40px;line-height:1.6}");
    s.push(".suggestions{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;max-width:560px;margin:0 auto}");
    s.push(".suggestion{padding:16px;background:var(--bg-2);border:1px solid var(--border);border-radius:12px;cursor:pointer;text-align:left;color:var(--fg-dim);font-size:14px;transition:all .15s var(--ease)}");
    s.push(".suggestion:hover{border-color:var(--fg-dim);color:var(--fg);}");

    s.push(".msg{display:flex;gap:16px;animation:fade-in-up .3s var(--ease); width: 100%;}");
    s.push(".msg.user{flex-direction:row-reverse}");
    s.push(".msg.user .avatar{display:none}");
    s.push(".avatar{width:32px;height:32px;border-radius:8px;flex-shrink:0;display:grid;place-items:center;font-size:14px;font-weight:600}");
    s.push(".avatar.bot{background:var(--bg-2);border:1px solid var(--border);color:var(--fg);}");
    s.push(".avatar.bot svg{width:20px;height:auto;display:block}");
    s.push(".bubble{max-width:85%;font-size:15px;line-height:1.6;word-wrap:break-word;overflow-wrap:break-word}");
    s.push(".msg.user .bubble{background:var(--user);color:var(--bg);padding:14px 20px;border-radius:24px;border-bottom-right-radius:6px;font-weight:500;}");
    s.push(".msg.bot .bubble{background:transparent;color:var(--fg);padding:4px 0;width:100%}");
    s.push(".bubble pre{background:var(--bg-2);border:1px solid var(--border);border-radius:12px;padding:16px;");
    s.push("  margin:16px 0;overflow-x:auto;font-size:13px;font-family:'JetBrains Mono','Fira Code',Consolas,monospace;box-shadow:inset 0 2px 8px rgba(0,0,0,0.1)}");
    s.push(".bubble code{background:var(--bg-3);padding:3px 6px;border-radius:6px;font-size:13.5px;font-family:'JetBrains Mono',Consolas,monospace}");
    s.push(".bubble pre code{background:transparent;padding:0}");
    s.push(".bubble p{margin:10px 0}");
    s.push(".bubble p:first-child{margin-top:0}.bubble p:last-child{margin-bottom:0}");
    s.push(".bubble ul,.bubble ol{margin:10px 0;padding-left:24px}");
    s.push(".bubble a{color:var(--fg);text-decoration:underline;text-underline-offset:4px;}");
    
    s.push(".tool-card{margin-top:12px;border:1px solid var(--border);border-radius:12px;background:var(--bg-2);");
    s.push("  font-size:13px;overflow:hidden;animation:fade-in-up .3s var(--ease)}");
    s.push(".tool-head{padding:12px 16px;display:flex;align-items:center;gap:12px;cursor:pointer;");
    s.push("  user-select:none;border-bottom:1px solid transparent;transition:background .15s var(--ease)}");
    s.push(".tool-head:hover{background:var(--bg-3)}");
    s.push(".tool-card.open .tool-head{border-bottom-color:var(--border)}");
    s.push(".tool-icon{width:24px;height:24px;border-radius:6px;background:var(--bg-3);display:grid;place-items:center;font-size:13px}");
    s.push(".tool-name{font-weight:500;color:var(--fg);font-family:'JetBrains Mono',monospace}");
    s.push(".tool-meta{margin-left:auto;color:var(--fg-faint);font-size:12px}");
    s.push(".tool-body{padding:12px 16px;display:none}");
    s.push(".tool-card.open .tool-body{display:block}");
    s.push(".tool-section{margin-bottom:12px}");
    s.push(".tool-section:last-child{margin-bottom:0}");
    s.push(".tool-label{font-size:11px;color:var(--fg-dim);text-transform:uppercase;letter-spacing:.05em;margin-bottom:6px;font-weight:600}");
    s.push(".tool-content{background:var(--bg);border:1px solid var(--border);border-radius:8px;padding:12px;");
    s.push("  font-family:'JetBrains Mono',monospace;font-size:12.5px;white-space:pre-wrap;word-break:break-word;max-height:300px;overflow-y:auto}");
    s.push(".tool-content.err{border-color:var(--err);color:var(--err);background:rgba(239,68,68,0.05)}");

    s.push(".typing{display:inline-flex;gap:4px;align-items:center;padding-top:8px}");
    s.push(".typing span{width:6px;height:6px;border-radius:50%;background:var(--fg-dim);animation:blink 1.2s infinite}");
    s.push(".typing span:nth-child(2){animation-delay:.2s}.typing span:nth-child(3){animation-delay:.4s}");
    s.push("@keyframes blink{0%,80%,100%{opacity:.3;transform:scale(.8)}40%{opacity:1;transform:scale(1)}}");
    s.push("@keyframes fade-in{from{opacity:0}to{opacity:1}}");
    s.push("@keyframes fade-in-up{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:translateY(0)}}");

    s.push(".composer{padding:0 24px 32px;background:transparent}");
    s.push(".composer-inner{max-width:800px;margin:0 auto;background:var(--bg-2);border:1px solid var(--border);");
    s.push("  border-radius:24px;padding:12px 16px;display:flex;gap:12px;align-items:flex-end;");
    s.push("  box-shadow:0 8px 32px rgba(0,0,0,0.2);transition:border-color .2s var(--ease)}");
    s.push(".composer-inner:focus-within{border-color:var(--fg-dim)}");
    s.push(".composer textarea{flex:1;background:transparent;border:none;outline:none;color:var(--fg);font-family:inherit;");
    s.push("  font-size:15px;resize:none;max-height:250px;padding:8px 4px;line-height:1.5}");
    s.push(".composer textarea::placeholder{color:var(--fg-faint)}");
    s.push(".send-btn{background:var(--fg);color:var(--bg);border:none;width:40px;height:40px;border-radius:12px;");
    s.push("  cursor:pointer;display:grid;place-items:center;font-size:18px;flex-shrink:0;transition:all .2s var(--ease)}");
    s.push(".send-btn:hover{transform:translateY(-2px);opacity:0.9;}");
    s.push(".send-btn:disabled{opacity:.4;cursor:not-allowed;transform:none;}");
    s.push(".composer-hint{max-width:800px;margin:12px auto 0;color:var(--fg-faint);font-size:12px;text-align:center}");

    s.push(".modal-bg{position:fixed;inset:0;background:rgba(0,0,0,.6);backdrop-filter:blur(5px);display:none;");
    s.push("  align-items:center;justify-content:center;z-index:50;animation:fade-in .2s var(--ease)}");
    s.push(".modal-bg.open{display:flex}");
    s.push(".modal{background:var(--bg-2);border:1px solid var(--border);border-radius:20px;width:min(700px,92vw);");
    s.push("  max-height:85vh;display:flex;flex-direction:column;box-shadow:var(--shadow);animation:fade-in-up .25s var(--ease)}");
    s.push(".modal-head{padding:24px;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:16px}");
    s.push(".modal-title{font-size:18px;font-weight:600;flex:1;letter-spacing:-0.01em}");
    s.push(".modal-close{background:transparent;border:none;color:var(--fg-dim);cursor:pointer;font-size:24px;");
    s.push("  width:36px;height:36px;border-radius:10px;display:grid;place-items:center;transition:all .15s}");
    s.push(".modal-close:hover{background:var(--bg-3);color:var(--fg)}");
    s.push(".modal-tabs{display:flex;gap:8px;padding:0 24px;border-bottom:1px solid var(--border)}");
    s.push(".tab-btn{background:transparent;border:none;color:var(--fg-dim);padding:14px 4px;cursor:pointer;");
    s.push("  font-size:14px;border-bottom:2px solid transparent;font-weight:500;margin-right:16px}");
    s.push(".tab-btn:hover{color:var(--fg)}.tab-btn.active{color:var(--fg);border-bottom-color:var(--fg)}");
    s.push(".modal-body{padding:24px;overflow-y:auto;flex:1}");
    s.push(".tab-pane{display:none;animation:fade-in .2s var(--ease)}");
    s.push(".tab-pane.active{display:block}");
    s.push(".form-row{margin-bottom:20px}");
    s.push(".form-row label{display:block;color:var(--fg);font-size:13px;margin-bottom:8px;font-weight:500;}");
    s.push(".form-row input,.form-row select,.form-row textarea{width:100%;background:var(--bg);border:1px solid var(--border);");
    s.push("  border-radius:10px;padding:12px 16px;color:var(--fg);font-family:inherit;font-size:14px;outline:none;");
    s.push("  transition:border-color .2s var(--ease)}");
    s.push(".form-row input:focus,.form-row select:focus,.form-row textarea:focus{border-color:var(--fg-dim)}");
    s.push(".form-row textarea{min-height:100px;resize:vertical;line-height:1.6}");
    s.push(".form-row .hint{color:var(--fg-faint);font-size:12px;margin-top:6px}");
    s.push(".slider-row{display:flex;align-items:center;gap:16px}");
    s.push(".slider-row input[type=range]{flex:1;accent-color:var(--fg)}");
    s.push(".slider-row .val{font-family:'JetBrains Mono',monospace;color:var(--fg);font-size:14px;min-width:40px;text-align:right}");
    s.push(".tool-toggle-list{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}");
    s.push(".tool-toggle{display:flex;align-items:center;gap:12px;padding:14px;background:var(--bg);");
    s.push("  border:1px solid var(--border);border-radius:10px;font-size:14px}");
    s.push(".tool-toggle input{accent-color:var(--fg);width:18px;height:18px}");
    s.push(".tool-toggle code{font-family:'JetBrains Mono',monospace;font-size:13px;color:var(--fg)}");
    s.push(".modal-foot{padding:20px 24px;border-top:1px solid var(--border);display:flex;justify-content:flex-end;gap:12px}");
    s.push(".btn{padding:12px 20px;border-radius:10px;border:1px solid var(--border);background:var(--bg);color:var(--fg);");
    s.push("  cursor:pointer;font-size:14px;font-weight:500;transition:all .2s var(--ease)}");
    s.push(".btn:hover{background:var(--bg-3)}");
    s.push(".btn.primary{background:var(--fg);border-color:transparent;color:var(--bg)}");
    s.push(".btn.primary:hover{opacity:0.9;transform:translateY(-1px);}");
    s.push(".pw-msg{font-size:13px;margin-bottom:16px;display:none;padding:10px 12px;border-radius:8px;line-height:1.5}");
    s.push(".pw-msg.ok{display:block;color:var(--ok);background:rgba(16,185,129,0.1)}");
    s.push(".pw-msg.err{display:block;color:var(--err);background:rgba(239,68,68,0.1)}");
    s.push(".provider-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px;margin-bottom:16px}");
    s.push(".provider-card{padding:16px;background:var(--bg);border:1px solid var(--border);border-radius:12px;");
    s.push("  cursor:pointer;text-align:center;transition:all .2s var(--ease);font-size:14px}");
    s.push(".provider-card:hover{border-color:var(--fg-dim)}");
    s.push(".provider-card.active{border-color:var(--fg);background:var(--bg-3);font-weight:500}");
    s.push(".provider-card .ico{font-size:24px;margin-bottom:8px}");

    s.push("::-webkit-scrollbar{width:8px;height:8px}");
    s.push("::-webkit-scrollbar-track{background:transparent}");
    s.push("::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}");
    s.push("::-webkit-scrollbar-thumb:hover{background:var(--fg-faint)}");

    s.push("@media(max-width:768px){");
    s.push("  .app{grid-template-columns:1fr}");
    s.push("  .app.sidebar-collapsed{grid-template-columns:1fr}");
    s.push("  .app.mobile-sidebar-open{grid-template-columns:1fr}");
    s.push("  .sidebar{position:fixed;left:0;top:0;bottom:0;width:260px;z-index:30;transform:translateX(-100%)}");
    s.push("  .app.mobile-sidebar-open .sidebar{transform:translateX(0)}");
    s.push("  .sidebar-backdrop{display:block;position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:29;opacity:0;pointer-events:none;transition:opacity .25s var(--ease)}");
    s.push("  .app.mobile-sidebar-open .sidebar-backdrop{opacity:1;pointer-events:auto}");
    s.push("  .tool-toggle-list{grid-template-columns:1fr}");
    s.push("  .suggestions{grid-template-columns:1fr}");
    s.push("  .topbar{padding:12px 14px;gap:10px}");
    s.push("  .topbar-title{font-size:14px}");
    s.push("  .provider-pill{font-size:11px;padding:5px 10px;gap:6px}");
    s.push("  .chat{padding:14px 8px 28px}");
    s.push("  .chat-inner{padding:0 10px;gap:24px}");
    s.push("  .composer{padding:0 12px 18px}");
    s.push("  .composer-inner{padding:10px 12px;border-radius:20px;gap:8px}");
    s.push("  .composer textarea{font-size:14.5px}");
    s.push("  .composer-hint{font-size:11px;margin-top:8px}");
    s.push("  .send-btn{width:36px;height:36px;border-radius:10px}");
    s.push("  .empty-state{padding:6vh 12px}");
    s.push("  .empty-state h2{font-size:24px}");
    s.push("  .empty-state p{font-size:14px;margin-bottom:28px}");
    s.push("  .bubble{font-size:14.5px;max-width:92%}");
    s.push("  .msg{gap:10px}");
    s.push("  .msg.user .bubble{padding:12px 16px;border-radius:20px;border-bottom-right-radius:6px}");
    s.push("  .provider-grid{grid-template-columns:repeat(auto-fill,minmax(130px,1fr))}");
    s.push("  .modal{width:96vw;max-height:92vh;border-radius:16px}");
    s.push("  .modal-head{padding:18px}");
    s.push("  .modal-body{padding:18px}");
    s.push("  .modal-foot{padding:14px 18px}");
    s.push("  .modal-tabs{padding:0 18px;overflow-x:auto;flex-wrap:nowrap;-webkit-overflow-scrolling:touch}");
    s.push("  .tab-btn{white-space:nowrap;margin-right:12px;flex-shrink:0}");
    s.push("  .form-row input,.form-row select,.form-row textarea{font-size:15px;padding:11px 14px}");
    s.push("  .login-card{padding:32px 24px;max-width:92vw}");
    s.push("}");
    s.push("@media(max-width:480px){");
    s.push("  .topbar{padding:10px 12px}");
    s.push("  .topbar-title{font-size:13.5px}");
    s.push("  .provider-pill > span:not(.status-dot){display:none}");
    s.push("  .provider-pill{padding:5px 8px}");
    s.push("  .empty-state h2{font-size:21px}");
    s.push("  .empty-state p{font-size:13.5px;margin-bottom:24px}");
    s.push("  .suggestion{padding:14px;font-size:13.5px}");
    s.push("  .sidebar-header{padding:18px 14px 14px}");
    s.push("  .new-chat{margin:6px 14px}");
    s.push("  .sessions{padding:8px 10px}");
    s.push("}");

    return s.join("\n");
}

func _js() {
    var s = [];
    s.push("// ====== Wyrmling Web UI ======");
    s.push("const $ = id => document.getElementById(id);");
    s.push("let state = { sessionId:null, sessions:[], config:null, sending:false, token:null, appInit:false };");
    s.push("");
    s.push("function escHtml(s){return String(s).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));}");
    s.push("");

    s.push("function md(t){");
    s.push("  if(!t) return '';");
    s.push("  let s = String(t);");
    s.push("  const blocks=[];");
    s.push("  s = s.replace(/```([\\w-]*)\\n?([\\s\\S]*?)```/g,(m,lang,code)=>{");
    s.push("    const idx=blocks.length;");
    s.push("    blocks.push('<pre><code class=\"lang-'+escHtml(lang||'')+'\">'+escHtml(code)+'</code></pre>');");
    s.push("    return '\\u0000B'+idx+'\\u0000';");
    s.push("  });");
    s.push("  s = escHtml(s);");
    s.push("  s = s.replace(/`([^`\\n]+)`/g,'<code>$1</code>');");
    s.push("  s = s.replace(/\\*\\*([^*\\n]+)\\*\\*/g,'<strong>$1</strong>');");
    s.push("  s = s.replace(/(^|\\W)\\*([^*\\n]+)\\*/g,'$1<em>$2</em>');");
    s.push("  s = s.replace(/\\[([^\\]]+)\\]\\(([^)]+)\\)/g,'<a href=\"$2\" target=\"_blank\" rel=\"noopener\">$1</a>');");
    s.push("  const lines = s.split(/\\n/);");
    s.push("  let out=[],inUl=false,inOl=false;");
    s.push("  for(const ln of lines){");
    s.push("    if(/^\\s*[-*]\\s+/.test(ln)){if(!inUl){out.push('<ul>');inUl=true}out.push('<li>'+ln.replace(/^\\s*[-*]\\s+/,'')+'</li>')}");
    s.push("    else if(/^\\s*\\d+\\.\\s+/.test(ln)){if(!inOl){out.push('<ol>');inOl=true}out.push('<li>'+ln.replace(/^\\s*\\d+\\.\\s+/,'')+'</li>')}");
    s.push("    else {if(inUl){out.push('</ul>');inUl=false}if(inOl){out.push('</ol>');inOl=false}");
    s.push("      if(ln.trim()==='') out.push(''); else out.push('<p>'+ln+'</p>');}");
    s.push("  }");
    s.push("  if(inUl)out.push('</ul>');if(inOl)out.push('</ol>');");
    s.push("  s = out.join('\\n');");
    s.push("  s = s.replace(/\\u0000B(\\d+)\\u0000/g,(m,i)=>blocks[+i]);");
    s.push("  return s;");
    s.push("}");
    s.push("");
    
    s.push("async function api(path, body, method){");
    s.push("  const ctrl = new AbortController();");
    s.push("  const timer = setTimeout(()=>ctrl.abort(), 300000);");
    s.push("  const fetchPath = path + (path.includes('?') ? '&' : '?') + 'token=' + encodeURIComponent(state.token || '');");
    s.push("  const opts={method:method||(body?'POST':'GET'),headers:{'Content-Type':'application/json'},signal:ctrl.signal};");
    s.push("  if(body) opts.body=JSON.stringify(body);");
    s.push("  const r = await fetch(fetchPath,opts);");
    s.push("  clearTimeout(timer);");
    s.push("  if(r.status === 401 && path !== '/api/login') { showLogin(); throw new Error('Unauthorized'); }");
    s.push("  if(!r.ok){");
    s.push("    let detail = '';");
    s.push("    try { const j = await r.json(); if(j && j.error) detail = ': '+j.error; } catch(e){}");
    s.push("    throw new Error(path+' returned '+r.status+detail);");
    s.push("  }");
    s.push("  return r.json();");
    s.push("}");

    s.push("function showLogin() { $('loginScreen').style.display='flex'; $('appRoot').style.display='none'; localStorage.removeItem('wyrm_token'); state.token=null; }");
    s.push("async function doLogin() {");
    s.push("  const u = $('loginUser').value; const p = $('loginPass').value;");
    s.push("  $('loginBtn').textContent = 'Authenticating...';");
    s.push("  try {");
    s.push("    const r = await api('/api/login', {username:u, password:p});");
    s.push("    if(r.ok) { state.token = r.token; localStorage.setItem('wyrm_token', r.token); $('loginScreen').style.display='none'; $('appRoot').style.display=''; $('loginErr').style.display='none'; await initApp(); }");
    s.push("  } catch(e) { $('loginErr').style.display='block'; $('loginErr').textContent = 'Invalid credentials'; }");
    s.push("  $('loginBtn').textContent = 'Sign In';");
    s.push("}");
    s.push("$('loginBtn').onclick = doLogin;");
    s.push("$('loginPass').onkeydown = (e) => { if(e.key === 'Enter') doLogin(); };");

    s.push("function appendUserMsg(text){");
    s.push("  const wrap = document.createElement('div'); wrap.className='msg user';");
    s.push("  wrap.innerHTML = '<div class=\"avatar user\">U</div><div class=\"bubble\">'+escHtml(text).replace(/\\n/g,'<br>')+'</div>';");
    s.push("  $('chat').appendChild(wrap); scrollChat();");
    s.push("}");
    s.push("function appendBotMsg(html, opts){");
    s.push("  opts = opts||{};");
    s.push("  const wrap = document.createElement('div'); wrap.className='msg bot';");
    s.push("  wrap.innerHTML = '<div class=\"avatar bot\"><svg viewBox=\"24 42 174 58\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\"><path d=\"M30 90 Q70 20 110 70 T190 60\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"10\" stroke-linecap=\"round\"/><circle cx=\"85\" cy=\"55\" r=\"7\" fill=\"#6366f1\"/></svg></div><div class=\"bubble\">'+html+'</div>';");
    s.push("  $('chat').appendChild(wrap); scrollChat(); return wrap;");
    s.push("}");
    s.push("function appendToolCard(name, args, result, isError){");
    s.push("  const card = document.createElement('div'); card.className='tool-card';");
    s.push("  const iconMap = {run_shell:'$_',run_python:'\\u{1F40D}',read_file:'\\u{1F4C4}',write_file:'\\u{1F4BE}',list_dir:'\\u{1F4C2}',");
    s.push("    delete_file:'\\u{1F5D1}',web_search:'\\u{1F50D}',fetch_url:'\\u{1F310}',core_memory_append:'\\u{1F9E0}',core_memory_remove:'\\u{1F9F9}',");
    s.push("    move_mouse:'\\u{1F5B1}',click_mouse:'\\u{1F5B1}',type_text:'\\u2328',press_key:'\\u2328',see_screen:'\\u{1F441}',");
    s.push("    get_time:'\\u23F0',calculator:'\\u{1F9EE}'};");
    s.push("  const icon = iconMap[name] || '\\u{1F527}';");
    s.push("  const argsStr = typeof args==='string'?args:JSON.stringify(args,null,2);");
    s.push("  const head = document.createElement('div'); head.className='tool-head';");
    s.push("  const ic = document.createElement('div'); ic.className='tool-icon'; ic.textContent=icon; head.appendChild(ic);");
    s.push("  const nm = document.createElement('span'); nm.className='tool-name'; nm.textContent=name; head.appendChild(nm);");
    s.push("  const mt = document.createElement('span'); mt.className='tool-meta'; mt.textContent=isError?'error':'expand'; head.appendChild(mt);");
    s.push("  const body = document.createElement('div'); body.className='tool-body';");
    s.push("  const sec1 = document.createElement('div'); sec1.className='tool-section';");
    s.push("  const lbl1 = document.createElement('div'); lbl1.className='tool-label'; lbl1.textContent='Arguments'; sec1.appendChild(lbl1);");
    s.push("  const con1 = document.createElement('div'); con1.className='tool-content'; con1.textContent=argsStr; sec1.appendChild(con1);");
    s.push("  body.appendChild(sec1);");
    s.push("  const sec2 = document.createElement('div'); sec2.className='tool-section';");
    s.push("  const lbl2 = document.createElement('div'); lbl2.className='tool-label'; lbl2.textContent='Result'; sec2.appendChild(lbl2);");
    s.push("  const con2 = document.createElement('div'); con2.className='tool-content'+(isError?' err':''); con2.textContent=result||'(running...)'; sec2.appendChild(con2);");
    s.push("  body.appendChild(sec2);");
    s.push("  card.appendChild(head); card.appendChild(body);");
    s.push("  head.onclick = () => card.classList.toggle('open');");
    s.push("  document.getElementById('chat').appendChild(card); scrollChat(); return card;");
    s.push("}");
    s.push("function appendTyping(){");
    s.push("  const wrap = document.createElement('div'); wrap.className='msg bot'; wrap.id='typingMsg';");
    s.push("  wrap.innerHTML = '<div class=\"avatar bot\"><svg viewBox=\"24 42 174 58\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\"><path d=\"M30 90 Q70 20 110 70 T190 60\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"10\" stroke-linecap=\"round\"/><circle cx=\"85\" cy=\"55\" r=\"7\" fill=\"#6366f1\"/></svg></div><div class=\"bubble\"><div class=\"typing\"><span></span><span></span><span></span></div></div>';");
    s.push("  $('chat').appendChild(wrap); scrollChat(); return wrap;");
    s.push("}");
    s.push("function removeTyping(){const t=$('typingMsg'); if(t) t.remove();}");
    s.push("function scrollChat(){const c=$('chat'); c.scrollTop = c.scrollHeight;}");
    s.push("");

    s.push("function renderEmpty(){");
    s.push("  const greet = ['Restart Next.js via PM2','What processes are taking up memory?','Check the current system temperature','Search the web for the latest AI news'];");
    s.push("  const c = $('chat'); c.innerHTML='';");
    s.push("  const wrap = document.createElement('div'); wrap.className='empty-state';");
    s.push("  wrap.innerHTML = '<h2>How can I assist?</h2><p>I am your secure, autonomous agent. I can interface with your system, write code, search the web, and more.</p>';");
    s.push("  const sg = document.createElement('div'); sg.className='suggestions';");
    s.push("  for(const g of greet){");
    s.push("    const b = document.createElement('button'); b.className='suggestion'; b.type='button'; b.textContent = g;");
    s.push("    b.addEventListener('click', () => { $('input').value = g; autoSize(); send(); });");
    s.push("    sg.appendChild(b);");
    s.push("  }");
    s.push("  wrap.appendChild(sg); c.appendChild(wrap);");
    s.push("}");
    s.push("");

    s.push("async function loadSessions(){");
    s.push("  const data = await api('/api/sessions');");
    s.push("  state.sessions = data.sessions || [];");
    s.push("  renderSessions();");
    s.push("}");
    s.push("function renderSessions(){");
    s.push("  const list = $('sessions'); list.innerHTML='';");
    s.push("  for(const s of state.sessions){");
    s.push("    const d = document.createElement('div');");
    s.push("    d.className = 'session-item' + (s.id===state.sessionId?' active':'');");
    s.push("    d.innerHTML = '<span>\\u{1F4AC}</span><span class=\"session-title\"></span><span class=\"session-del\" title=\"delete\">\\u00D7</span>';");
    s.push("    d.querySelector('.session-title').textContent = s.title || 'Untitled';");
    s.push("    d.onclick = (e)=>{ if(e.target.classList.contains('session-del')) return; openSession(s.id); };");
    s.push("    d.querySelector('.session-del').onclick = async (e)=>{e.stopPropagation();");
    s.push("      if(!confirm('Delete this chat?')) return;");
    s.push("      await api('/api/sessions/'+s.id, null, 'DELETE');");
    s.push("      if(state.sessionId===s.id) state.sessionId=null;");
    s.push("      await loadSessions();");
    s.push("      if(!state.sessionId) await newSession();");
    s.push("    };");
    s.push("    list.appendChild(d);");
    s.push("  }");
    s.push("}");
    s.push("async function newSession(){");
    s.push("  const r = await api('/api/sessions', {});");
    s.push("  state.sessionId = r.id;");
    s.push("  await loadSessions();");
    s.push("  await openSession(r.id, true);");
    s.push("}");
    s.push("async function openSession(id, isNew){");
    s.push("  state.sessionId = id;");
    s.push("  $('topbarTitle').textContent = (state.sessions.find(s=>s.id===id)||{}).title || 'New Chat';");
    s.push("  renderSessions();");
    s.push("  if(window.innerWidth<=768) document.querySelector('.app').classList.remove('mobile-sidebar-open');");
    s.push("  $('chat').innerHTML='';");
    s.push("  if(isNew){ renderEmpty(); return; }");
    s.push("  const data = await api('/api/sessions/'+id);");
    s.push("  if(!data.messages || data.messages.length<=1){ renderEmpty(); return; }");
    s.push("  const msgs = data.messages.slice(1);");
    s.push("  for(let i=0;i<msgs.length;i++){");
    s.push("    const m = msgs[i];");
    s.push("    if(m.role==='user') appendUserMsg(m.content);");
    s.push("    else if(m.role==='assistant'){");
    s.push("      if(m.content && m.content.trim()) appendBotMsg(md(m.content));");
    s.push("      if(m.tool_calls){");
    s.push("        for(const tc of m.tool_calls){");
    s.push("          let args=tc.function.arguments; try{args=JSON.parse(args);}catch(e){}");
    s.push("          let result=''; let isErr=false;");
    s.push("          for(let j=i+1;j<msgs.length;j++){");
    s.push("            if(msgs[j].role==='tool' && msgs[j].tool_call_id===tc.id){result=msgs[j].content;break;}");
    s.push("          }");
    s.push("          appendToolCard(tc.function.name, args, result, isErr);");
    s.push("        }");
    s.push("      }");
    s.push("    }");
    s.push("  }");
    s.push("}");
    s.push("");

    s.push("async function send(){");
    s.push("  if(state.sending) return;");
    s.push("  const text = $('input').value.trim();");
    s.push("  if(!text) return;");
    s.push("  if(!state.sessionId) await newSession();");
    s.push("  if($('chat').querySelector('.empty-state')) $('chat').innerHTML='';");
    s.push("  appendUserMsg(text);");
    s.push("  $('input').value=''; autoSize();");
    s.push("  state.sending = true; updateSendBtn();");
    s.push("  appendTyping();");
    s.push("  try{");
    s.push("    const r = await api('/api/chat', {session_id: state.sessionId, message: text});");
    s.push("    removeTyping();");
    s.push("    if(r.trace){");
    s.push("      const seenCalls = {};");
    s.push("      for(const ev of r.trace){");
    s.push("        if(ev.kind==='thought' && ev.text && ev.text.trim()) appendBotMsg(md(ev.text));");
    s.push("        else if(ev.kind==='tool_call'){");
    s.push("          const card = appendToolCard(ev.name, ev.args, '...running');");
    s.push("          seenCalls[ev.id] = card;");
    s.push("        }");
    s.push("        else if(ev.kind==='tool_result'){");
    s.push("          const card = seenCalls[ev.id];");
    s.push("          if(card){");
    s.push("            const resBox = card.querySelectorAll('.tool-content')[1];");
    s.push("            if(resBox) resBox.textContent = ev.result;");
    s.push("            const meta = card.querySelector('.tool-meta');");
    s.push("            if(meta) meta.textContent = 'expand';");
    s.push("          }");
    s.push("        }");
    s.push("        else if(ev.kind==='error') appendBotMsg('<span style=\"color:var(--err)\">\\u26A0 '+escHtml(ev.message)+'</span>');");
    s.push("      }");
    s.push("    }");
    s.push("    await loadSessions();");
    s.push("    const cur = state.sessions.find(s=>s.id===state.sessionId);");
    s.push("    if(cur) $('topbarTitle').textContent = cur.title;");
    s.push("  }catch(e){");
    s.push("    removeTyping();");
    s.push("    appendBotMsg('<span style=\"color:var(--err)\">System error: '+escHtml(e.message)+'</span>');");
    s.push("  }finally{");
    s.push("    state.sending = false; updateSendBtn();");
    s.push("  }");
    s.push("}");
    s.push("function updateSendBtn(){");
    s.push("  const b = $('sendBtn');");
    s.push("  b.innerHTML = state.sending ? '\\u23F8' : '\\u2191';");
    s.push("  b.disabled = state.sending;");
    s.push("}");
    s.push("function autoSize(){const t=$('input'); t.style.height='auto'; t.style.height=Math.min(t.scrollHeight,250)+'px';}");
    s.push("");

    s.push("async function loadSettings(){");
    s.push("  const r = await api('/api/settings');");
    s.push("  state.config = r.config;");
    s.push("  renderSettings();");
    s.push("  applyTheme();");
    s.push("}");
    s.push("function applyTheme(){");
    s.push("  const t = state.config && state.config.agent && state.config.agent.theme;");
    s.push("  document.documentElement.setAttribute('data-theme', t==='light'?'light':'dark');");
    s.push("}");
    s.push("function renderSettings(){");
    s.push("  if(!state.config) return;");
    s.push("  const cfg = state.config;");
    s.push("  const grid = $('providerGrid'); grid.innerHTML='';");
    s.push("  const icons = {ollama:'\\u{1F999}', openai:'\\u{2728}', anthropic:'\\u{1F9E0}', groq:'\\u{26A1}', deepseek:'\\u{2728}', custom:'\\u{1F527}'};");
    s.push("  for(const key of Object.keys(cfg.providers)){");
    s.push("    const p = cfg.providers[key];");
    s.push("    const c = document.createElement('div');");
    s.push("    c.className = 'provider-card' + (cfg.agent.active_provider===key?' active':'');");
    s.push("    c.innerHTML = '<div class=\"ico\">'+(icons[key]||'\\u{1F4E1}')+'</div><div>'+escHtml(p.label||key)+'</div>';");
    s.push("    c.onclick = ()=>{ cfg.agent.active_provider = key; renderSettings(); updatePill(); };");
    s.push("    grid.appendChild(c);");
    s.push("  }");
    s.push("  const ap = cfg.agent.active_provider; const pcfg = cfg.providers[ap]||{};");
    s.push("  $('p_label').value = pcfg.label || '';");
    s.push("  $('p_kind').value = pcfg.kind || 'openai';");
    s.push("  $('p_base').value = pcfg.base_url || '';");
    s.push("  $('p_model').value = pcfg.model || '';");
    s.push("  $('p_key').value = pcfg.api_key || '';");
    s.push("  $('temp').value = cfg.agent.temperature; $('tempVal').textContent = (+cfg.agent.temperature).toFixed(2);");
    s.push("  $('mtok').value = cfg.agent.max_tokens; $('mtokVal').textContent = cfg.agent.max_tokens;");
    s.push("  $('msteps').value = cfg.agent.max_steps; $('mstepsVal').textContent = cfg.agent.max_steps;");
    s.push("  $('ctx').value = cfg.agent.context_window; $('ctxVal').textContent = cfg.agent.context_window;");
    s.push("  $('sysExtra').value = cfg.agent.system_prompt_extra || '';");
    s.push("  $('themeSel').value = cfg.agent.theme || 'dark';");
    s.push("  const tl = $('toolList'); tl.innerHTML='';");
    s.push("  for(const tname of Object.keys(cfg.tools)){");
    s.push("    const lbl = document.createElement('label');");
    s.push("    lbl.className='tool-toggle';");
    s.push("    lbl.innerHTML = '<input type=\"checkbox\" '+(cfg.tools[tname]?'checked':'')+'><code>'+escHtml(tname)+'</code>';");
    s.push("    lbl.querySelector('input').onchange = e => { cfg.tools[tname] = e.target.checked; };");
    s.push("    tl.appendChild(lbl);");
    s.push("  }");
    s.push("  updatePill();");
    s.push("}");
    s.push("function updatePill(){");
    s.push("  if(!state.config) return;");
    s.push("  const ap = state.config.agent.active_provider;");
    s.push("  const p = state.config.providers[ap]||{};");
    s.push("  $('providerPill').innerHTML = '<span class=\"status-dot\"></span><span><b>'+escHtml(p.label||ap)+'</b> &middot; '+escHtml(p.model||'')+'</span>';");
    s.push("}");
    s.push("async function saveSettings(){");
    s.push("  if(!state.config) return;");
    s.push("  const cfg = state.config; const ap = cfg.agent.active_provider;");
    s.push("  cfg.providers[ap].label = $('p_label').value;");
    s.push("  cfg.providers[ap].kind = $('p_kind').value;");
    s.push("  cfg.providers[ap].base_url = $('p_base').value;");
    s.push("  cfg.providers[ap].model = $('p_model').value;");
    s.push("  cfg.providers[ap].api_key = $('p_key').value;");
    s.push("  cfg.agent.temperature = +$('temp').value;");
    s.push("  cfg.agent.max_tokens = +$('mtok').value;");
    s.push("  cfg.agent.max_steps = +$('msteps').value;");
    s.push("  cfg.agent.context_window = +$('ctx').value;");
    s.push("  cfg.agent.system_prompt_extra = $('sysExtra').value;");
    s.push("  cfg.agent.theme = $('themeSel').value;");
    s.push("  await api('/api/settings', {config: cfg});");
    s.push("  applyTheme(); updatePill();");
    s.push("  closeSettings();");
    s.push("}");
    s.push("function openSettings(){$('settingsModal').classList.add('open'); renderSettings();}");
    s.push("function closeSettings(){$('settingsModal').classList.remove('open');}");
    s.push("function switchTab(t){");
    s.push("  document.querySelectorAll('.tab-btn').forEach(b=>b.classList.toggle('active',b.dataset.tab===t));");
    s.push("  document.querySelectorAll('.tab-pane').forEach(p=>p.classList.toggle('active',p.id==='tab-'+t));");
    s.push("}");
    s.push("async function changePassword(){");
    s.push("  const cur = $('pw_current').value;");
    s.push("  const nw = $('pw_new').value;");
    s.push("  const cf = $('pw_confirm').value;");
    s.push("  const msg = $('pw_msg');");
    s.push("  msg.className = 'pw-msg';");
    s.push("  if(!cur || !nw || !cf){ msg.className='pw-msg err'; msg.textContent='All fields are required.'; return; }");
    s.push("  if(nw !== cf){ msg.className='pw-msg err'; msg.textContent='New passwords do not match.'; return; }");
    s.push("  if(nw.length < 4){ msg.className='pw-msg err'; msg.textContent='New password must be at least 4 characters.'; return; }");
    s.push("  if(nw === cur){ msg.className='pw-msg err'; msg.textContent='New password must differ from the current one.'; return; }");
    s.push("  const btn = $('changePwBtn'); btn.disabled = true; btn.textContent = 'Updating...';");
    s.push("  try{");
    s.push("    const r = await api('/api/change-password', {current_password: cur, new_password: nw});");
    s.push("    if(r.ok){");
    s.push("      msg.className='pw-msg ok'; msg.textContent='Password updated successfully.';");
    s.push("      $('pw_current').value=''; $('pw_new').value=''; $('pw_confirm').value='';");
    s.push("      if(state.config && state.config.security) state.config.security.password = nw;");
    s.push("    }");
    s.push("  }catch(e){");
    s.push("    msg.className='pw-msg err';");
    s.push("    const m = String(e.message||''); const ix = m.indexOf(': ');");
    s.push("    msg.textContent = ix >= 0 ? m.substring(ix+2) : 'Failed to update password.';");
    s.push("  }finally{");
    s.push("    btn.disabled = false; btn.textContent = 'Update Password';");
    s.push("  }");
    s.push("}");
    s.push("");
    
    s.push("async function initApp(){");
    s.push("  if(state.appInit) return;");
    s.push("  state.appInit = true;");
    s.push("  await loadSettings();");
    s.push("  await loadSessions();");
    s.push("  if(state.sessions.length>0) await openSession(state.sessions[0].id);");
    s.push("  else await newSession();");
    s.push("  $('input').addEventListener('input', autoSize);");
    s.push("  $('input').addEventListener('keydown', e=>{");
    s.push("    if(e.key==='Enter' && !e.shiftKey){e.preventDefault(); send();}");
    s.push("  });");
    s.push("  $('sendBtn').onclick = send;");
    s.push("  $('newChatBtn').onclick = newSession;");
    s.push("  $('settingsBtn').onclick = openSettings;");
    s.push("  $('logoutBtn').onclick = ()=>{");
    s.push("    if(!confirm('Sign out of Wyrmling?')) return;");
    s.push("    state.appInit=false; state.sessionId=null; state.sessions=[]; state.config=null;");
    s.push("    showLogin();");
    s.push("  };");
    s.push("  $('closeSettings').onclick = closeSettings;");
    s.push("  $('saveSettings').onclick = saveSettings;");
    s.push("  $('changePwBtn').onclick = changePassword;");
    s.push("  $('themeToggle').onclick = ()=>{");
    s.push("    state.config.agent.theme = state.config.agent.theme==='light'?'dark':'light';");
    s.push("    applyTheme(); api('/api/settings',{config:state.config});");
    s.push("  };");
    s.push("  $('sidebarToggle').onclick = ()=>{");
    s.push("    if(window.innerWidth<=768) document.querySelector('.app').classList.toggle('mobile-sidebar-open');");
    s.push("    else document.querySelector('.app').classList.toggle('sidebar-collapsed');");
    s.push("  };");
    s.push("  $('sidebarBackdrop').onclick = ()=>{ document.querySelector('.app').classList.remove('mobile-sidebar-open'); };");
    s.push("  document.querySelectorAll('.tab-btn').forEach(b=>b.onclick=()=>switchTab(b.dataset.tab));");
    s.push("  ['temp','mtok','msteps','ctx'].forEach(id=>{");
    s.push("    $(id).oninput = e => {");
    s.push("      const v = e.target.value;");
    s.push("      $(id+'Val').textContent = id==='temp'?(+v).toFixed(2):v;");
    s.push("    };");
    s.push("  });");
    s.push("  $('input').focus();");
    s.push("}");

    s.push("async function init(){");
    s.push("  state.token = localStorage.getItem('wyrm_token');");
    s.push("  if(state.token) {");
    s.push("    try { const r = await api('/api/health'); if(r.ok) { $('loginScreen').style.display='none'; $('appRoot').style.display=''; await initApp(); } else showLogin(); } catch(e) { showLogin(); }");
    s.push("  } else { showLogin(); }");
    s.push("}");
    s.push("init();");

    return s.join("\n");
}

func _html() {
    var h = [];
    h.push("<!DOCTYPE html>");
    h.push("<html lang=\"en\" data-theme=\"dark\">");
    h.push("<head>");
    h.push("<meta charset=\"UTF-8\">");
    h.push("<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">");
    h.push("<title>Wyrmling - Autonomous Agent</title>");
    h.push("<link href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap\" rel=\"stylesheet\">");
    h.push("<style>");
    h.push(_css());
    h.push("</style>");
    h.push("</head>");
    h.push("<body>");
    
    h.push("<div id=\"loginScreen\" class=\"login-bg\">");
    h.push("  <div class=\"login-card\">");
    h.push("    <svg class=\"login-logo\" viewBox=\"24 42 174 58\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" aria-label=\"Wyrmling\">");
    h.push("      <path d=\"M30 90 Q70 20 110 70 T190 60\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"3\" stroke-linecap=\"round\"/>");
    h.push("      <circle cx=\"85\" cy=\"55\" r=\"3\" fill=\"#6366f1\"/>");
    h.push("    </svg>");
    h.push("    <h2>Wyrmling</h2>");
    h.push("    <p class=\"login-sub\">An Autonomous Agent</p>");
    h.push("    <div id=\"loginErr\" class=\"login-err\">Invalid credentials</div>");
    h.push("    <input type=\"text\" id=\"loginUser\" class=\"login-input\" placeholder=\"Username\" />");
    h.push("    <input type=\"password\" id=\"loginPass\" class=\"login-input\" placeholder=\"Password\" />");
    h.push("    <button class=\"login-btn\" id=\"loginBtn\">Sign In</button>");
    h.push("    <div class=\"login-foot\">Made with <b>Dragon</b></div>");
    h.push("  </div>");
    h.push("</div>");

    h.push("<div class=\"app\" id=\"appRoot\" style=\"display:none\">");

    h.push("  <div class=\"sidebar-backdrop\" id=\"sidebarBackdrop\"></div>");

    h.push("  <aside class=\"sidebar\">");
    h.push("    <div class=\"sidebar-header\">");
    h.push("      <div class=\"logo\"><svg viewBox=\"24 42 174 58\" xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" aria-label=\"Wyrmling\"><path d=\"M30 90 Q70 20 110 70 T190 60\" fill=\"none\" stroke=\"#6366f1\" stroke-width=\"10\" stroke-linecap=\"round\"/><circle cx=\"85\" cy=\"55\" r=\"7\" fill=\"#6366f1\"/></svg></div>");
    h.push("      <div><div class=\"brand\">Wyrmling</div><div class=\"brand-sub\">Agent OS</div></div>");
    h.push("    </div>");
    h.push("    <button class=\"new-chat\" id=\"newChatBtn\">+ New Chat</button>");
    h.push("    <div class=\"sessions\" id=\"sessions\"></div>");
    h.push("    <div class=\"sidebar-footer\">");
    h.push("      <div class=\"sidebar-status-row\">");
    h.push("        <span class=\"status-dot\"></span>");
    h.push("        <span>Secure Session</span>");
    h.push("        <button class=\"icon-btn\" id=\"themeToggle\" title=\"Theme\">&#x263D;</button>");
    h.push("        <button class=\"icon-btn\" id=\"settingsBtn\" title=\"Settings\">&#x2699;</button>");
    h.push("      </div>");
    h.push("      <button class=\"logout-btn\" id=\"logoutBtn\" title=\"Sign Out\"><svg class=\"icn\" xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4\"/><polyline points=\"16 17 21 12 16 7\"/><line x1=\"21\" y1=\"12\" x2=\"9\" y2=\"12\"/></svg><span>Sign Out</span></button>");
    h.push("    </div>");
    h.push("  </aside>");

    h.push("  <main class=\"main\">");
    h.push("    <div class=\"topbar\">");
    h.push("      <button class=\"icon-btn\" id=\"sidebarToggle\" title=\"Toggle sidebar\" style=\"border:none;background:var(--bg-2);\">&#x2630;</button>");
    h.push("      <div class=\"topbar-title\" id=\"topbarTitle\">Wyrmling Session</div>");
    h.push("      <div class=\"provider-pill\" id=\"providerPill\"><span class=\"status-dot\"></span><span>...</span></div>");
    h.push("    </div>");
    h.push("    <div class=\"chat\" id=\"chat\"></div>");
    h.push("    <div class=\"composer\">");
    h.push("      <div class=\"composer-inner\">");
    h.push("        <textarea id=\"input\" rows=\"1\" placeholder=\"Message Wyrmling... (Enter to send)\"></textarea>");
    h.push("        <button class=\"send-btn\" id=\"sendBtn\">&#x2191;</button>");
    h.push("      </div>");
    h.push("      <div class=\"composer-hint\">Commands execute directly on your host machine.</div>");
    h.push("    </div>");
    h.push("  </main>");
    h.push("</div>");

    h.push("<div class=\"modal-bg\" id=\"settingsModal\">");
    h.push("  <div class=\"modal\">");
    h.push("    <div class=\"modal-head\">");
    h.push("      <span class=\"modal-title\">Configuration</span>");
    h.push("      <button class=\"modal-close\" id=\"closeSettings\">&#x00D7;</button>");
    h.push("    </div>");
    h.push("    <div class=\"modal-tabs\">");
    h.push("      <button class=\"tab-btn active\" data-tab=\"provider\">Provider</button>");
    h.push("      <button class=\"tab-btn\" data-tab=\"behavior\">Behavior</button>");
    h.push("      <button class=\"tab-btn\" data-tab=\"tools\">Tools</button>");
    h.push("      <button class=\"tab-btn\" data-tab=\"appearance\">Appearance</button>");
    h.push("      <button class=\"tab-btn\" data-tab=\"security\">Security</button>");
    h.push("    </div>");
    h.push("    <div class=\"modal-body\">");
    h.push("      <div class=\"tab-pane active\" id=\"tab-provider\">");
    h.push("        <div class=\"form-row\"><label>Active Provider</label>");
    h.push("          <div class=\"provider-grid\" id=\"providerGrid\"></div>");
    h.push("        </div>");
    h.push("        <div class=\"form-row\"><label>Display Name</label><input id=\"p_label\"></div>");
    h.push("        <div class=\"form-row\"><label>Provider Type</label>");
    h.push("          <select id=\"p_kind\"><option value=\"ollama\">Ollama (local)</option><option value=\"openai\">OpenAI / OpenAI-compatible</option><option value=\"anthropic\">Anthropic Claude</option><option value=\"deepseek\">DeepSeek</option></select>");
    h.push("          <div class=\"hint\">Use 'OpenAI / compatible' for Groq, Together, OpenRouter, LM Studio, vLLM, etc.</div>");
    h.push("        </div>");
    h.push("        <div class=\"form-row\"><label>Base URL</label><input id=\"p_base\" placeholder=\"https://api.openai.com/v1\"></div>");
    h.push("        <div class=\"form-row\"><label>Model</label><input id=\"p_model\" placeholder=\"gpt-4o-mini\"></div>");
    h.push("        <div class=\"form-row\"><label>API Key</label><input id=\"p_key\" type=\"password\" placeholder=\"sk-...\"><div class=\"hint\">Stored securely locally.</div></div>");
    h.push("      </div>");

    h.push("      <div class=\"tab-pane\" id=\"tab-behavior\">");
    h.push("        <div class=\"form-row\"><label>Temperature</label><div class=\"slider-row\"><input type=\"range\" id=\"temp\" min=\"0\" max=\"2\" step=\"0.05\"><span class=\"val\" id=\"tempVal\"></span></div><div class=\"hint\">Lower = more focused, higher = more creative.</div></div>");
    h.push("        <div class=\"form-row\"><label>Max Tokens</label><div class=\"slider-row\"><input type=\"range\" id=\"mtok\" min=\"256\" max=\"8192\" step=\"128\"><span class=\"val\" id=\"mtokVal\"></span></div></div>");
    h.push("        <div class=\"form-row\"><label>Max Autonomous Steps</label><div class=\"slider-row\"><input type=\"range\" id=\"msteps\" min=\"1\" max=\"30\" step=\"1\"><span class=\"val\" id=\"mstepsVal\"></span></div><div class=\"hint\">How many tool-call rounds the agent may take before stopping.</div></div>");
    h.push("        <div class=\"form-row\"><label>Context Window (messages)</label><div class=\"slider-row\"><input type=\"range\" id=\"ctx\" min=\"6\" max=\"100\" step=\"2\"><span class=\"val\" id=\"ctxVal\"></span></div><div class=\"hint\">Older messages get pruned beyond this count.</div></div>");
    h.push("        <div class=\"form-row\"><label>Extra System Prompt</label><textarea id=\"sysExtra\" placeholder=\"Custom behaviors...\"></textarea></div>");
    h.push("      </div>");

    h.push("      <div class=\"tab-pane\" id=\"tab-tools\">");
    h.push("        <div class=\"form-row\"><label>Enabled Tools</label>");
    h.push("          <div class=\"tool-toggle-list\" id=\"toolList\"></div>");
    h.push("          <div class=\"hint\">Disabled tools won't be exposed to the model. GUI tools require user32.dll (Windows).</div>");
    h.push("        </div>");
    h.push("      </div>");
    h.push("      <div class=\"tab-pane\" id=\"tab-appearance\">");
    h.push("        <div class=\"form-row\"><label>Theme</label>");
    h.push("          <select id=\"themeSel\"><option value=\"dark\">Dark</option><option value=\"light\">Light</option></select>");
    h.push("        </div>");
    h.push("      </div>");
    h.push("      <div class=\"tab-pane\" id=\"tab-security\">");
    h.push("        <div class=\"form-row\"><label>Current Password</label><input id=\"pw_current\" type=\"password\" placeholder=\"Enter current password\" autocomplete=\"current-password\"></div>");
    h.push("        <div class=\"form-row\"><label>New Password</label><input id=\"pw_new\" type=\"password\" placeholder=\"Enter new password\" autocomplete=\"new-password\"><div class=\"hint\">Use at least 4 characters.</div></div>");
    h.push("        <div class=\"form-row\"><label>Confirm New Password</label><input id=\"pw_confirm\" type=\"password\" placeholder=\"Re-enter new password\" autocomplete=\"new-password\"></div>");
    h.push("        <div id=\"pw_msg\" class=\"pw-msg\"></div>");
    h.push("        <button class=\"btn primary\" id=\"changePwBtn\">Update Password</button>");
    h.push("      </div>");
    h.push("    </div>");
    h.push("    <div class=\"modal-foot\">");
    h.push("      <button class=\"btn\" onclick=\"closeSettings()\">Cancel</button>");
    h.push("      <button class=\"btn primary\" id=\"saveSettings\">Save Changes</button>");
    h.push("    </div>");
    h.push("  </div>");
    h.push("</div>");

    h.push("<script>");
    h.push(_js());
    h.push("</script>");
    h.push("</body></html>");
    return h.join("\n");
}

func generate() {
    var html = _html();
    file.write(UI_PATH, html);
    return UI_PATH;
}