        "name": "see_screen",
        "description": "Take a screenshot of the user's display and analyze it with a local Ollama vision model (llama3.2-vision). Use when you need to see what's on screen, find a button, or verify a click landed correctly.",
        "parameters": { "type": "object", "properties": {}, "required": [] }
