import "os"
import "file"
import "json"
import "net"
import "time"
import "path" as pt
import "ffi"
import "math"

import "../config" as config
import "../memory" as mem
import "../logger" as logger


var SYSTEM_OS = os.name();
var IS_WINDOWS = SYSTEM_OS == "windows";
var user32 = null;
if (IS_WINDOWS) {
    try {
        user32 = ffi.loadlib("user32.dll");
        ffi.def(user32, "SetCursorPos", "bool", ["int", "int"]);
        ffi.def(user32, "mouse_event", "void", ["int", "int", "int", "int", "int"]);
    } catch (e) {
        logger.warn("Failed to load user32.dll - mouse control disabled");
        user32 = null;
    }
}
var MOUSEEVENTF_LEFTDOWN  = 2;
var MOUSEEVENTF_LEFTUP    = 4;
var MOUSEEVENTF_RIGHTDOWN = 8;
var MOUSEEVENTF_RIGHTUP   = 16;


var ALL_SCHEMAS = [
    {
        "name": "run_shell",
        "description": "Execute a single shell/terminal command and return stdout+stderr. Use to install packages, list files, run system tasks, or invoke other CLIs.",
        "parameters": {
            "type": "object",
            "properties": { "cmd": { "type": "string", "description": "The shell command to run" } },
            "required": ["cmd"]
        }
    },
    {
        "name": "run_python",
        "description": "Execute Python source code and return its stdout/stderr. Use for data work, GUI automation with pyautogui, or any logic that's easier to write in Python.",
        "parameters": {
            "type": "object",
            "properties": { "code": { "type": "string", "description": "Raw Python source to execute" } },
            "required": ["code"]
        }
    },
    {
        "name": "read_file",
        "description": "Read the contents of a text file. Returns up to 4000 chars; large files are truncated.",
        "parameters": {
            "type": "object",
            "properties": { "filepath": { "type": "string" } },
            "required": ["filepath"]
        }
    },
    {
        "name": "write_file",
        "description": "Create or overwrite a file with the given contents.",
        "parameters": {
            "type": "object",
            "properties": {
                "filepath": { "type": "string" },
                "content":  { "type": "string" }
            },
            "required": ["filepath", "content"]
        }
    },
    {
        "name": "list_dir",
        "description": "List files and folders inside a directory. Pass empty string for current working directory.",
        "parameters": {
            "type": "object",
            "properties": { "dir_path": { "type": "string" } },
            "required": ["dir_path"]
        }
    },
    {
        "name": "delete_file",
        "description": "Permanently delete a file. Cannot be undone.",
        "parameters": {
            "type": "object",
            "properties": { "filepath": { "type": "string" } },
            "required": ["filepath"]
        }
    },
    {
        "name": "web_search",
        "description": "Search the web for CURRENT EVENTS, NEWS, or facts dated after your training cutoff. NEVER use this for definitions, identity questions ('who are you'), basic facts, math, or anything you already know. If you can answer from general knowledge, DO NOT use this tool.",
        "parameters": {
            "type": "object",
            "properties": { "query": { "type": "string" } },
            "required": ["query"]
        }
    },
    {
        "name": "fetch_url",
        "description": "Fetch a URL and return its visible text content (HTML stripped). Use to read articles, docs, or links from search results.",
        "parameters": {
            "type": "object",
            "properties": { "url": { "type": "string" } },
            "required": ["url"]
        }
    },
    {
        "name": "core_memory_append",
        "description": "Save a durable fact (user name, preference, project detail) so it persists across conversations and is auto-included in your system prompt.",
        "parameters": {
            "type": "object",
            "properties": {
                "key":   { "type": "string", "description": "Short label like 'User Name' or 'Preferred Language'" },
                "value": { "type": "string", "description": "The fact to remember" }
            },
            "required": ["key", "value"]
        }
    },
    {
        "name": "core_memory_remove",
        "description": "Forget a fact previously saved with core_memory_append.",
        "parameters": {
            "type": "object",
            "properties": { "key": { "type": "string" } },
            "required": ["key"]
        }
    },
    {
        "name": "move_mouse",
        "description": "Move the OS cursor to absolute screen coordinates (x, y). Windows-only via user32.dll.",
        "parameters": {
            "type": "object",
            "properties": { "x": { "type": "integer" }, "y": { "type": "integer" } },
            "required": ["x", "y"]
        }
    },
    {
        "name": "click_mouse",
        "description": "Click the mouse at its current position. button must be 'left' or 'right'.",
        "parameters": {
            "type": "object",
            "properties": { "button": { "type": "string", "enum": ["left", "right"] } },
            "required": ["button"]
        }
    },
    {
        "name": "type_text",
        "description": "Type a string of text via simulated keyboard. Uses pyautogui under the hood.",
        "parameters": {
            "type": "object",
            "properties": { "text": { "type": "string" } },
            "required": ["text"]
        }
    },
    {
        "name": "press_key",
        "description": "Press one key by name (e.g. 'enter', 'tab', 'esc', 'win'). Uses pyautogui.",
